# --- Required ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Optional overrides (defaults shown) ---
ENVIRONMENT=dev
LOG_LEVEL=INFO
LOG_FORMAT=json

LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2

MAX_SUB_QUESTIONS=5
MAX_PAPERS_PER_SUB_QUESTION=8
MAX_CONCURRENT_RESEARCH_AGENTS=5

WEB_SEARCH_PROVIDER=duckduckgo
BRAVE_API_KEY=

SQLITE_PATH=./data/lit_review.db
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_CACHE_DIR=./data/embeddings_cache

API_PORT=8000
RATE_LIMIT_REQUESTS_PER_MINUTE=20

# --- Search API Keys (for SerpApi / ScholarAPI) ---
# WEB_SEARCH_PROVIDER=serpapi
SERPAPI_API_KEY=
# WEB_SEARCH_PROVIDER=scholarapi
SCHOLARAPI_API_KEY=
